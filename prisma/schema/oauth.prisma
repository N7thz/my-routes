// Servidor OAuth do MCP (plugin `mcp` do Better Auth), para o claude.ai e outros
// clientes MCP se conectarem com login em vez de token colado. Os nomes dos
// campos seguem o schema do plugin (oidc-provider); não renomeie.

// Cliente OAuth registrado sozinho pelo cliente MCP (registro dinâmico).
model OauthApplication {
  id           String    @id
  name         String
  icon         String?
  metadata     String?
  clientId     String    @unique
  clientSecret String?
  redirectUrls String
  type         String
  disabled     Boolean?  @default(false)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime
  updatedAt    DateTime
  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
  @@map("oauth_application")
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  client                OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime
  updatedAt             DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id           String           @id
  clientId     String
  client       OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  consentGiven Boolean
  createdAt    DateTime
  updatedAt    DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}
