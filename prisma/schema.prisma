generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// --- Empresas ---

enum CompanyStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  REVISAO

  @@map("company_status")
}

model Company {
  id              String         @id @default(cuid())
  name            String
  cnpj            String?
  address         String?
  lat             Float?
  lng             Float?
  // Última tentativa de geocodificação sem resultado: tira da fila do cron
  // até o endereço mudar (editar o endereço zera o campo).
  geocodeFailedAt DateTime?      @map("geocode_failed_at")
  date            DateTime?
  status          CompanyStatus?
  observations    String?
  notionId        String?        @unique
  groupId         String?        @map("group_id")
  group           CompanyGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  stops           Stop[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([groupId])
  @@map("company")
}

// Agrupamento livre de empresas (ex.: por região, cliente, contrato).
// Cada empresa pertence a no máximo um grupo.
model CompanyGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String?
  companies Company[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("company_group")
}

// --- Rotas ---

enum RouteStatus {
  RASCUNHO
  EM_ANDAMENTO
  CONCLUIDA

  @@map("route_status")
}

model Route {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime?   @db.Date
  status    RouteStatus @default(RASCUNHO)
  stops     Stop[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("route")
}

model Stop {
  id              String    @id @default(cuid())
  routeId         String    @map("route_id")
  route           Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  companyId       String?   @map("company_id")
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Evento do Google Agenda que originou a parada. Permite ressincronizar sem
  // duplicar e remover a parada quando o evento sai da agenda.
  calendarEventId String?   @map("calendar_event_id")
  label           String?
  address         String
  lat             Float?
  lng             Float?
  geocodeFailedAt DateTime? @map("geocode_failed_at")
  order           Int       @default(0)
  visitedAt       DateTime? @map("visited_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([routeId, calendarEventId])
  @@map("stop")
}

// --- Better Auth models ---

// --- Rota do dia automática ---

// Preferências da geração automática de rotas (cron diário e botão "Gerar
// agora"). Sem registro, o usuário fica de fora do cron — exceto o
// CRON_USER_EMAIL, que já era atendido antes desta tabela existir.
model AutoRouteSettings {
  userId         String    @id @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled        Boolean   @default(true)
  useRunrunit    Boolean   @default(true) @map("use_runrunit")
  useCalendar    Boolean   @default(true) @map("use_calendar")
  optimizeOrder  Boolean   @default(true) @map("optimize_order")
  // Ponto de saída e chegada do dia (casa/escritório) usado na otimização.
  originAddress  String?   @map("origin_address")
  originLat      Float?    @map("origin_lat")
  originLng      Float?    @map("origin_lng")
  lastRunAt      DateTime? @map("last_run_at")
  lastRunOk      Boolean?  @map("last_run_ok")
  lastRunSummary String?   @map("last_run_summary")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("auto_route_settings")
}

model User {
  id            String             @id
  name          String
  email         String             @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  routes        Route[]
  autoRoute     AutoRouteSettings?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
